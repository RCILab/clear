FROM gcbfplus-benchmark:cpu

# Keep the public implementation and its validated Python dependency set, but
# replace the CPU-only JAX wheel with the matching CUDA 12 build.
RUN pip install --no-cache-dir --upgrade \
    "jax[cuda12_pip]==0.4.23" \
    -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html \
    && pip install --no-cache-dir --force-reinstall \
       "nvidia-cublas-cu12==12.9.2.10" \
       "nvidia-cuda-cupti-cu12==12.9.79" \
       "nvidia-cuda-nvcc-cu12==12.9.86" \
       "nvidia-cuda-nvrtc-cu12==12.9.86" \
       "nvidia-cuda-runtime-cu12==12.9.79" \
       "nvidia-cudnn-cu12==8.9.7.29" \
       "nvidia-cufft-cu12==11.4.1.4" \
       "nvidia-cusolver-cu12==11.7.5.82" \
       "nvidia-cusparse-cu12==12.5.10.65" \
       "nvidia-nccl-cu12==2.30.7" \
       "nvidia-nvjitlink-cu12==12.9.86"

# The archived CUDA wheel marks xla_extension.so as requiring an executable
# stack. Docker Desktop/WSL rejects that legacy ELF flag; JAX does not need it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends patchelf \
    && find /usr/local/lib/python3.10/site-packages/jaxlib \
       -type f -name '*.so' -exec patchelf --clear-execstack {} \; \
    && rm -rf /var/lib/apt/lists/*

ENV JAX_PLATFORM_NAME=gpu
ENV XLA_PYTHON_CLIENT_PREALLOCATE=false
